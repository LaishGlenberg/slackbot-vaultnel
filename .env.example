# Slack tokens — see slack/manifest.yaml for the app definition
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Not used in Socket Mode; keep for a later HTTP Events migration
SLACK_SIGNING_SECRET=

# LLM: deepseek | openrouter
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Separate cheap model for summarization + fact extraction (defaults to LLM_MODEL)
LLM_UTILITY_MODEL=
# LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
# off | low | high | max
THINKING_LEVEL=off

# Persona; SYSTEM_PROMPT_FILE wins over SYSTEM_PROMPT
SYSTEM_PROMPT=
SYSTEM_PROMPT_FILE=
INCLUDE_SPEAKER_NAMES=true

# Memory tiers (token budgets)
SHORT_TERM_TOKENS=2000
SUMMARY_MAX_TOKENS=400
COMPACT_TRIGGER_TOKENS=2500
KEEP_RECENT_TURNS=6
FACT_EXTRACTION_EVERY=4
FACT_MAX_PER_SCOPE=100
RECALL_TOP_K=3
PROMPT_BUDGET_TOKENS=6000
THREAD_TTL_HOURS=72
MEMORY_QUEUE_MAX=100

# Integrations: remote MCP servers as a JSON object. Empty disables tools.
# Example (GitHub's remote server; token is read from GITHUB_TOKEN):
# MCP_SERVERS={"github":{"url":"https://api.githubcopilot.com/mcp/","token_env":"GITHUB_TOKEN","tools":["get_pull_request","list_pull_requests","get_check_runs"]}}
MCP_SERVERS=
MCP_ROUNDS=3
MCP_CALLS_PER_TURN=4
MCP_RESULT_TOKENS=1200
MCP_TIMEOUT_SECONDS=30

DB_PATH=data/vaultnel.db
MAX_CONCURRENT_LLM=4
STREAM_INTERVAL=1.0
LOG_LEVEL=INFO
